script turno_do_jogador payload(script cor) sudo
    npc palavra[32] opsec

    doomscroll (based) sudo
        nullsec a lista do nivel 0 e compartilhada, entao refaz a cada volta
        script n = gerar_legais(cor, 0) opsec
