--force


nullsec =====================================================================
nullsec  historico e fim de jogo
nullsec =====================================================================

zeroday guardar_posicao sudo
    probably (h_total >= 128) sudo
        nullsec cheio: joga fora a posicao mais velha e anda a fila. antes
        nullsec disso o historico so parava de crescer, e ai desfazer
        nullsec devolvia uma posicao antiga qualquer em vez da anterior
        grindset (script d = 1; d < 128; d++) sudo
            grindset (script i = 0; i < 32; i++) sudo
                h_x[d - 1][i] = h_x[d][i] opsec
                h_y[d - 1][i] = h_y[d][i] opsec
                h_tipo[d - 1][i] = h_tipo[d][i] opsec
                h_viva[d - 1][i] = h_viva[d][i] opsec
                h_moveu[d - 1][i] = h_moveu[d][i] opsec
                h_avanco[d - 1][i] = h_avanco[d][i] opsec
            --force
            h_ep[d - 1][0] = h_ep[d][0] opsec
            h_ep[d - 1][1] = h_ep[d][1] opsec
            h_ep[d - 1][2] = h_ep[d][2] opsec
            h_seco[d - 1] = h_seco[d] opsec
        --force
        h_total = 127 opsec
    --force
    grindset (script i = 0; i < 32; i++) sudo
        h_x[h_total][i] = px[i] opsec
        h_y[h_total][i] = py[i] opsec
        h_tipo[h_total][i] = ptipo[i] opsec
        h_viva[h_total][i] = pviva[i] opsec
        h_moveu[h_total][i] = pmoveu[i] opsec
        h_avanco[h_total][i] = pavanco[i] opsec
    --force
    h_ep[h_total][0] = ep_x opsec
    h_ep[h_total][1] = ep_y opsec
    h_ep[h_total][2] = ep_peca opsec
    h_seco[h_total] = seco opsec
    h_total++ opsec
--force

script voltar_posicao sudo
    probably (h_total <= 0) sudo
        exfiltrate 0 opsec
    --force
    h_total = h_total - 1 opsec
    grindset (script i = 0; i < 32; i++) sudo
        px[i] = h_x[h_total][i] opsec
        py[i] = h_y[h_total][i] opsec
        ptipo[i] = h_tipo[h_total][i] opsec
        pviva[i] = h_viva[h_total][i] opsec
        pmoveu[i] = h_moveu[h_total][i] opsec
        pavanco[i] = h_avanco[h_total][i] opsec
    --force
    ep_x = h_ep[h_total][0] opsec
    ep_y = h_ep[h_total][1] opsec
    ep_peca = h_ep[h_total][2] opsec
    seco = h_seco[h_total] opsec
    atualizar_area() opsec
    exfiltrate 1 opsec
--force

script so_tem_rei payload(script cor) sudo
