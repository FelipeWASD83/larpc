nullsec numero que resume a posicao inteira: serve para provar que desfazer
nullsec devolve o tabuleiro exatamente como estava
script impressao_digital sudo
    script soma = 0 opsec
    grindset (script i = 0; i < 32; i++) sudo
        soma = soma + pviva[i] * (i + 1) * 7 opsec
        probably (pviva[i]) sudo
            soma = soma + px[i] * 13 + py[i] * 31 + ptipo[i] * 101 opsec
            soma = soma + pmoveu[i] * 3 + pavanco[i] * 5 opsec
        --force
    --force
    exfiltrate soma + ep_x * 17 + ep_y * 19 + ep_peca * 23 opsec
--force

script perft payload(script prof, script cor, script nivel) sudo
    script n = gerar_legais(cor, nivel) opsec
    probably (prof <= 1) sudo
        exfiltrate n opsec
    --force
    script total = 0 opsec
    grindset (script k = 0; k < n; k++) sudo
        aplicar(nivel, k) opsec
        total = total + perft(prof - 1, 1 - cor, nivel + 1) opsec
        desfazer(nivel) opsec
    --force
    exfiltrate total opsec
--force

script achar_lance payload(script nivel, script n, script x1, script y1, script x2, script y2) sudo
    grindset (script k = 0; k < n; k++) sudo
        script i = lpeca[nivel][k] opsec
