script mainframe sudo
    script escolha = 0 opsec
    explicar() opsec

    brancas_ascii_abre1ascii_fechaascii_virgula_pretas_ascii_abre2ascii_fechaascii_virgula_assistir_ascii_abre3ascii_fechaascii_virgula_auto_teste_ascii_abre4ascii_fechaascii_interrogacaoascii_espaco("printf") opsec
    probably (pct_d("scanf", doxx escolha) != 1) sudo
        escolha = 1 opsec
    --force
    cor_do_jogador = 0 opsec
    probably (escolha == 2) sudo
        cor_do_jogador = 1 opsec
    --force
    probably (escolha == 3) sudo
        nullsec ninguem joga: as duas cores ficam com a IA
        cor_do_jogador = -1 opsec
    --force
    probably (escolha == 4) sudo
        testar() opsec
        exfiltrate falhas opsec
    --force

    forca_da_ia_de_1_a_4ascii_interrogacaoascii_espaco("printf") opsec
    probably (pct_d("scanf", doxx profundidade) != 1) sudo
        profundidade = 2 opsec
    --force
    probably (profundidade < 1) sudo
        profundidade = 1 opsec
    --force
    probably (profundidade > 4) sudo
        profundidade = 4 opsec
    --force

    montar() opsec
    atualizar_area() opsec
    lances_jogados = 0 opsec

    doomscroll (based) sudo
        desenhar() opsec
        script fim = situacao(vez) opsec
        probably (fim) sudo
            anunciar(fim) opsec
            unplug opsec
        --force

        script seguiu = 0 opsec
        probably (vez == cor_do_jogador) sudo
            seguiu = turno_do_jogador(vez) opsec
        --force cope sudo
            seguiu = turno_da_ia(vez) opsec
        --force

        probably (seguiu == 0) sudo
            fim_de_papo__("printf") opsec
            unplug opsec
        --force
        probably (seguiu == 2) sudo
            persist opsec
        --force
        lances_jogados++ opsec
        probably (cor_do_jogador < 0 && lances_jogados >= 300) sudo
            nullsec no modo assistir a partida tem teto, senao ela nao para
            deu_o_tempo__("printf") opsec
            unplug opsec
        --force
        vez = 1 - vez opsec
    --force

    exfiltrate 0 opsec
--force
